# ValidateKB.cmake - pure-CMake structural check of the gprconfig knowledge base.
# Usage: cmake -DKB_DB_DIR=<path to db/> -P ValidateKB.cmake
# For every db/*.xml: file is non-empty, starts with "<?xml" or "<gprconfig>",
# and has balanced <gprconfig> ... </gprconfig> root tags (exactly one root).
if(NOT KB_DB_DIR)
  message(FATAL_ERROR "ValidateKB: KB_DB_DIR is not set")
endif()
if(NOT IS_DIRECTORY "${KB_DB_DIR}")
  message(FATAL_ERROR "ValidateKB: not a directory: ${KB_DB_DIR}")
endif()
file(GLOB _files "${KB_DB_DIR}/*.xml")
list(LENGTH _files _count)
if(_count EQUAL 0)
  message(FATAL_ERROR "ValidateKB: no *.xml files in ${KB_DB_DIR}")
endif()

set(_errors "")
foreach(_f IN LISTS _files)
  get_filename_component(_name "${_f}" NAME)
  if(NOT EXISTS "${_f}")
    list(APPEND _errors "${_name}: does not exist")
    continue()
  endif()
  file(SIZE "${_f}" _size)
  if(_size EQUAL 0)
    list(APPEND _errors "${_name}: empty file")
    continue()
  endif()
  file(READ "${_f}" _content)
  string(REGEX REPLACE "^[ \t\r\n]+" "" _head "${_content}")
  if(NOT (_head MATCHES "^<\\?xml" OR _head MATCHES "^<gprconfig>"))
    list(APPEND _errors "${_name}: does not start with '<?xml' or '<gprconfig>'")
    continue()
  endif()
  set(_nocomment "${_content}")
  string(REGEX MATCHALL "<gprconfig[ \t\r\n]*>" _opens "${_nocomment}")
  string(REGEX MATCHALL "</gprconfig[ \t\r\n]*>" _closes "${_nocomment}")
  list(LENGTH _opens _no)
  list(LENGTH _closes _nc)
  if(NOT _no EQUAL _nc)
    list(APPEND _errors "${_name}: unbalanced <gprconfig> root (${_no} open, ${_nc} close)")
  elseif(_no EQUAL 0)
    list(APPEND _errors "${_name}: no <gprconfig> root element")
  endif()
endforeach()

if(_errors)
  list(JOIN _errors "\n  " _msg)
  message(FATAL_ERROR "ValidateKB: ${_count} files checked, problems found:\n  ${_msg}")
endif()
message(STATUS "ValidateKB: ${_count} files in ${KB_DB_DIR} are structurally valid")
